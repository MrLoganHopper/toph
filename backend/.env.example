APP_ENV=development
# Run python ../scripts/configure_local.py to create local-only random secrets.
DATABASE_URL=
# Operator/CLI only. Do not add migration credentials to the backend Vercel project.
MIGRATION_DATABASE_URL=
POSTGIS_SCHEMA=public
APP_ORIGINS=["http://localhost:5173"]
COOKIE_SECURE=false
CSRF_SECRET=
RATE_LIMIT_SECRET=
# Default uses the TCP peer, never arbitrary X-Forwarded-For.
TRUST_VERCEL_PROXY=false
AWS_REGION=us-west-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=
OPENAI_TRANSCRIPTION_MODEL=
OPENAI_EXTRACT_MODEL=
OPENAI_VOICE=marin
AI_REQUEST_TIMEOUT_SECONDS=45
MAX_RECORDING_BYTES=26214400
MAX_RECORDING_DURATION_MS=600000
